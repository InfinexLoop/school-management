{
  "name": "nanjil-grove-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "node scripts/ensure-db.mjs && prisma generate && prisma db push && tsx prisma/seed.ts",
    "db:migration:generate": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script --output migrations/0001_initial.sql",
    "cf:d1:migrate": "cf d1 migrations apply a49ee4c1-80bb-43e7-9252-51aa5a3fe6e9",
    "cf:d1:local": "cf d1 migrations apply a49ee4c1-80bb-43e7-9252-51aa5a3fe6e9 --local",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy",
    "deploy": "npm run build:vinext && npm run deploy:vinext"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "latest",
    "@prisma/adapter-d1": "^7.10.1",
    "@prisma/client": "latest",
    "@vinext/cloudflare": "^1.3.4",
    "bcryptjs": "latest",
    "date-fns": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "^19.3.1",
    "recharts": "latest",
    "vinext": "^1.4.5",
    "zod": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.15",
    "@cloudflare/workers-types": "^5.20261112.1",
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "better-sqlite3": "latest",
    "cf": "^1.0.0-beta.30",
    "prisma": "7.10.1",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "^8.3.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "better-sqlite3@13.1.1": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261110.1": true
  },
  "overrides": {
    "fflate": "0.8.2"
  },
  "type": "module"
}
